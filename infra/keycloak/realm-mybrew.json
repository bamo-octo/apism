{
  "realm": "mybrew",
  "displayName": "MyBrew",
  "displayNameHtml": "<strong>MyBrew</strong> &mdash; la machine a cafe de l'entreprise",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": false,
  "requiredCredentials": [
    "password"
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "saml_organization",
    "AuthnContextClassRef",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization"
  ],
  "roles": {
    "realm": [
      {
        "name": "buveur",
        "description": "Peut consulter le catalogue et se faire couler une boisson."
      },
      {
        "name": "technicien",
        "description": "Peut remplir les reservoirs, vider le bac a marc et detartrer la machine."
      },
      {
        "name": "administrateur",
        "description": "Peut consulter les statistiques de consommation et purger l'historique."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "audience-mybrew-api",
      "description": "Ajoute l'audience mybrew-api au jeton d'acces.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-mybrew-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "mybrew-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "audience-gravitee",
      "description": "Ajoute l'audience gravitee-introspection au jeton. Keycloak 26 refuse d'introspecter un jeton dont le client appelant n'est pas dans l'audience.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-gravitee",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gravitee-introspection",
            "included.custom.audience": "",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "boisson:preparer",
      "description": "Autorise l'application a commander une boisson au nom de l'utilisateur.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Commander des boissons en votre nom"
      }
    },
    {
      "name": "machine:entretenir",
      "description": "Autorise l'application a declencher les operations d'entretien.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Entretenir la machine a cafe"
      }
    },
    {
      "name": "statistiques:lire",
      "description": "Autorise l'application a lire les statistiques de consommation.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Consulter les statistiques de consommation"
      }
    },
    {
      "name": "machine:telemetrie",
      "description": "Autorise un service a publier les releves de la machine.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "saml_organization",
