# Versions des briques d'infrastructure du TP.
# Ces valeurs sont volontairement figees : tout le monde travaille sur les memes.
VERSION_APIM=4.12.19
VERSION_KEYCLOAK=26.7
VERSION_MONGO=7
VERSION_ELASTIC=8.17.2

# --- Keycloak -----------------------------------------------------------------
# Console d'administration Keycloak : http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_MOT_DE_PASSE_ADMIN=admin
KEYCLOAK_REALM=mybrew

# --- Gravitee APIM ------------------------------------------------------------
# Console : http://localhost:8084 - portail : http://localhost:4100
GRAVITEE_ADMIN=admin
GRAVITEE_MOT_DE_PASSE_ADMIN=admin

# --- Secrets des clients OAuth (formation uniquement) -------------------------
SECRET_SONDE=sonde-secret-de-formation
SECRET_GRAVITEE_INTROSPECTION=gravitee-secret-de-formation

# --- SPA MyBrew ---------------------------------------------------------------
# A l'etape finale, la SPA n'appelle plus l'API en direct mais la gateway.
WEB_URL_API=http://localhost:8082/mybrew
WEB_ETAPE=Etape 10 - architecture finale
WEB_AUTHENTIFICATION_ACTIVEE=true

# --- Limites appliquees par la gateway ----------------------------------------
# Nombre de boissons par utilisateur et par minute, puis par jour.
LIMITE_DEBIT_PAR_MINUTE=3
QUOTA_PAR_JOUR=20
